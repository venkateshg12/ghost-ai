{
  "name": "@repo/types",
  "version": "1.0.0",
  "description": "Shared Zod schemas and types for apps/server and apps/web",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "typescript": "5.9.2",
    "vitest": "^5.0.3"
  },
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./layout": {
      "types": "./dist/graphLayout.d.ts",
      "default": "./dist/graphLayout.js"
    },
    "./package.json": "./package.json"
