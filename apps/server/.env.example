PORT=5000
NODE_ENV=development
# The web app's origin(s), comma-separated. Cookies are sent cross-origin only to these.
CORS_ORIGIN=http://localhost:3000
# Origin used for links inside emails. Defaults to the first entry of CORS_ORIGIN.
CLIENT_URL=http://localhost:3000

# Postgres. A fresh database — run `pnpm db:plan init && pnpm db:apply` once to create the tables.
# Local docker: postgresql://plano:plano@localhost:5432/plano
DATABASE_URL="postgresql://user:password@localhost:5432/plano"

# Two DIFFERENT random secrets of at least 32 characters each; the server refuses to start otherwise.
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Internal API secret for Trigger.dev tasks and internal engine routes (min 32 chars).
INTERNAL_API_SECRET=
# Where Trigger.dev tasks reach this API. Only the deployed tasks use it; they run elsewhere, so it must be the API's public URL
# (e.g. https://<api>.onrender.com). Local development defaults to http://127.0.0.1:<PORT>.
# INTERNAL_API_URL=


# Gmail API sender (verification + password reset emails). One-time setup: start the server, open
# http://localhost:5000/api/auth/gmail as the sender account (noreply.gvprojects@gmail.com), then paste the
# refresh token printed in the server console into GMAIL_REFRESH_TOKEN and restart.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
# Optional display name shown next to the sender address.
GMAIL_SENDER_NAME=
# Authorization routes are always on outside production; set true only while re-authorizing in production.
GMAIL_OAUTH_SETUP=false

# Google sign-in (optional). Same OAuth client id as NEXT_PUBLIC_GOOGLE_CLIENT_ID in apps/web.
GOOGLE_CLIENT_ID=

# Proxies in front of this app whose client-IP headers may be believed, as comma-separated CIDRs.
# Leave EMPTY when the server is exposed directly. See the e-commerce auth-service notes for details.
TRUSTED_PROXY_CIDRS=
DEBUG_IP_ENDPOINT=false

# Free-tier hosting (web on Vercel, API on Render): the browser talks to the web app's /backend path, which
# forwards to this API, so auth cookies stay first-party. Leave all of these unset for local development.
# Shared with the web app (same value there, 24+ chars). It proves a request came through the proxy, so the
# real visitor IP in x-plano-client-ip is trusted for rate limiting.
PROXY_SHARED_SECRET=
# Path the browser sees the refresh endpoint under. Behind the proxy: /backend/auth/refresh.
REFRESH_COOKIE_PATH=/backend/auth/refresh
# strict (default) | lax | none. Keep strict behind the proxy. "none" is only a fallback for a web app and API
# on different sites, and Brave, Safari and Firefox block those cookies.
AUTH_COOKIE_SAMESITE=strict

# BullMQ dashboard at /admin/queues. Job payloads contain reset/verification tokens, so it stays off
# unless switched on here, and needs credentials when on.
ENABLE_QUEUE_DASHBOARD=false
QUEUE_DASHBOARD_USER=
QUEUE_DASHBOARD_PASSWORD=

# Queue + rate limiter Redis (docker-compose service `redis`). Must use the `noeviction` policy.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Cache Redis — a SEPARATE instance (docker-compose service `redis-cache`, port 6380) that may evict.
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6380
CACHE_REDIS_USERNAME=
CACHE_REDIS_PASSWORD=
CACHE_ENABLED=true


# Trigger.dev (AI design + spec tasks). Secret key from the project's API keys page (tr_dev_... for
# local, tr_prod_... in production); the project ref (proj_...) is read by trigger.config.ts.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

# AI providers, tried in AI_PROVIDER_ORDER (NVIDIA first, Gemini as the fallback). With no key at all the
# built-in offline generators are used in development; production refuses to run without one.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_PROVIDER_ORDER=nvidia,google
# Per-attempt timeout in ms before the next provider is tried (default 45000).
# AI_TIMEOUT_MS=45000
# AI_NVIDIA_TIMEOUT_MS=1   # force the Gemini fallback while testing
# Gemini (second provider), plus a backup Gemini model tried right after it (empty disables).
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vercel Blob read-write token. Leave empty to store canvas snapshots and specs under LOCAL_STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=
LOCAL_STORAGE_DIR=.storage
