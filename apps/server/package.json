{
  "name": "server",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Ghost AI API: Express + Prisma (Postgres) + BullMQ (email) + Trigger.dev (AI tasks)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "start:worker": "tsx src/worker.ts",
    "trigger:dev": "trigger dev",
    "trigger:deploy": "trigger deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "contract:emit": "prisma contract emit",
    "db:plan": "prisma contract emit && prisma migration plan --name",
    "db:apply": "pnpm run db:sql && prisma db migrate && prisma db sign",
    "db:sql": "tsx src/scripts/write-migration-sql.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.90",
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@liveblocks/node": "3.21.0",
    "@liveblocks/react-flow": "3.21.0",
    "@prisma/cli-engine": "^0.4.0",
    "@prisma/orm-postgres": "8.0.0-rc.11",
    "@repo/types": "workspace:*",
    "@trigger.dev/sdk": "^4.7.3",
    "@vercel/blob": "^2.8.1",
    "ai": "^7.0.130",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.9",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pg": "^8.23.0",
    "proxy-addr": "^2.0.8",
    "resend": "^4.8.0",
    "tsx": "^4.22.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@trigger.dev/build": "^4.7.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.3",
    "@types/pg": "8.20.4",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.2.14",
    "@xyflow/react": "^12.11.1",
    "eslint": "^9.39.1",
    "prisma": "8.0.0-rc.15",
    "trigger.dev": "^4.7.3",
    "typescript": "5.9.2"
  }
}
