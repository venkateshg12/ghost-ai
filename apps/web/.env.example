# The Express API (apps/server). Requests are sent with credentials, so it must list this app's
# origin in its CORS_ORIGIN.
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_REALTIME_URL=ws://localhost:5000/realtime


# Same-origin proxy for hosting where the web app and API live on different sites (Vercel + Render free tier).
# Set NEXT_PUBLIC_API_URL=/backend, and these two (server-side only, never NEXT_PUBLIC_):
# API_PROXY_TARGET=https://your-api.onrender.com
# PROXY_SHARED_SECRET=<same value as the API's PROXY_SHARED_SECRET>

# Google sign-in (optional). The same OAuth client id as GOOGLE_CLIENT_ID on the server.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
